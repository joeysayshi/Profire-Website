{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/team-3",
      "destination": "/team/",
      "permanent": true
    },
    {
      "source": "/certifications",
      "destination": "/certifications/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/general-8",
      "destination": "/afss-inspections/",
      "permanent": true
    },
    {
      "source": "/copy-of-the-afss-process",
      "destination": "/routine-fire-inspections/",
      "permanent": true
    },
    {
      "source": "/copy-of-routine-inspections",
      "destination": "/fire-equipment-repairs/",
      "permanent": true
    },
    {
      "source": "/copy-of-fire-equipment-repairs-and-pr-1",
      "destination": "/smoke-alarm-testing/",
      "permanent": true
    },
    {
      "source": "/services-4",
      "destination": "/after-hours-fire-service/",
      "permanent": true
    },
    {
      "source": "/get-in-touch",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/post/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/afss",
      "destination": "/afss-inspections/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(site.css|site.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}